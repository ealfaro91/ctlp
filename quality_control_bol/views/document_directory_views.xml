<odoo>

    <record id="document_directory_view_kanban_inh" model="ir.ui.view">
        <field name="name">document.directory.view.kanban.inh</field>
        <field name="model">document.directory</field>
        <field name="inherit_id" ref="windx_documents_management_preview.document_directory_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('col-6')]" position="attributes">
                <attribute name="class">col-4</attribute>
            </xpath>
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">area_id</attribute>
                 <attribute name="group_create">0</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="area_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="document_directory_view_inh" model="ir.ui.view">
        <field name="name">document.directory.view.inh</field>
        <field name="model">document.directory</field>
        <field name="inherit_id" ref="windx_documents_management_preview.view_document_directory_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="before">
                <div class="oe_title">
                    <label for="name" string="Folder"/>
                    <h1>
                        <div class="d-flex">
                            <field name="name"/>
                        </div>
                    </h1>
                </div>
            </xpath>
            <xpath expr="//field[@name='visible_directory']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='model']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="area_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="document_file_type_ids" widget="many2many_tags"/>
            </xpath>
             <xpath expr="//page[@name='child']/field[@name='child_ids']" position="replace">
                 <field name="child_ids" mode="kanban" context="{'default_parent_id': id}" nolabel="1"/>
             </xpath>
            <xpath expr="//page[@name='user_ids']" position="replace">
                <page string="Users" name="user_ids">
                    <field name="user_ids" widget="many2many" options="{'not_delete': True}"  context="{'search_default_filter_no_share':1}">
                        <kanban quick_create="false" create="true" delete="true">
                            <field name="id"/>
                            <field name="name"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click" style="max-width: 200px">
                                        <div class="o_kanban_record_top">
                                            <img t-att-src="kanban_image('res.users', 'image_128', record.id.raw_value)" class="oe_avatar oe_kanban_avatar_smallbox o_image_40_cover mb0" alt="Avatar"/>
                                            <div class="o_kanban_record_headings ml8">
                                                <strong class="o_kanban_record_title">
                                                    <field name="name"/>
                                                </strong>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="windx_documents_management_preview.document_directory_kanban_action" model="ir.actions.act_window">
        <field name="domain">[('parent_id','=', False)]</field>
    </record>


</odoo>
