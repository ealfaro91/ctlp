<odoo>

    <!-- FORM VIEW -->

    <record id="project_fsn_system_form_view" model="ir.ui.view">
        <field name="name">project.fsn.system.form.view</field>
        <field name="model">project.fsn.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Sub-Category"/>
                        <h1>
                            <div class="d-flex">
                                <field name="name"/>
                                <field name="active" invisible="1"/>
                            </div>
                        </h1>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->

    <record id="project_fsn_system_tree_view" model="ir.ui.view">
        <field name="name">project.fsn.system.tree.view</field>
        <field name="model">project.fsn.system</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->

    <record id="project_fsn_system_search_view" model="ir.ui.view">
        <field name="name">project.fsn.system.search.view</field>
        <field name="model">project.fsn.system</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->

    <record id="project_fsn_system_action" model="ir.actions.act_window">
        <field name="name">Project Fsn System</field>
        <field name="res_model">project.fsn.system</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENUS -->

   <menuitem
        id="project_fsn_system_menu"
        name="Project FSN system"
        parent="project.menu_project_config"
        action="project_fsn_system_action"
        sequence="15"/>


</odoo>
