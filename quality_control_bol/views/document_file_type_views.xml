<odoo>

    <!-- TREE VIEW -->

    <record id="document_file_type_tree_view" model="ir.ui.view">
        <field name="name">document.file.type.tree.view</field>
        <field name="model">document.file.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="active"/>
                <field name="name"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->

    <record id="document_file_type_form_view" model="ir.ui.view">
        <field name="name">document.file.type.form.view</field>
        <field name="model">document.file.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="File type"/>
                        <h1>
                            <div class="d-flex">
                                <field name="name"/>
                            </div>
                        </h1>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->

    <record id="document_file_type_search_view" model="ir.ui.view">
        <field name="name">document.file.type.search.view</field>
        <field name="model">document.file.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->

    <record id="document_file_type_action" model="ir.actions.act_window">
        <field name="name">Document File Type</field>
        <field name="res_model">document.file.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENUS -->

   <menuitem
        id="document_file_type_menu"
        name="Document File Type"
        parent="windx_documents_management_preview.menu_document_configuration"
        action="document_file_type_action"
        sequence="16"/>


</odoo>
