<odoo>

    <!-- TREE VIEW INHERIT -->

    <record id="view_approval_log_document_tree" model="ir.ui.view">
        <field name="name">aproval.log.document.tree</field>
        <field name="model">approval.log</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="document_signature.view_approval_log_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="after">
                <field name="attachment_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- FORM VIEW INHERIT -->

    <record id="view_approval_log_document_form" model="ir.ui.view">
        <field name="name">aproval.log.document.form</field>
        <field name="model">approval.log</field>
        <field name="inherit_id" ref="document_signature.view_approval_log_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="after">
                <field name="attachment_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>

