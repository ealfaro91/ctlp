<odoo>

    <record id="view_approval_log_project_tree" model="ir.ui.view">
        <field name="name">aproval.log.document.tree</field>
        <field name="model">approval.log</field>
        <field name="inherit_id" ref="document_signature.view_approval_log_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="after">
                <field name="project_fsn_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_approval_log_project_form" model="ir.ui.view">
        <field name="name">aproval.log.document.form</field>
        <field name="model">approval.log</field>
        <field name="inherit_id" ref="view_approval_log_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="after">
                <field name="project_fsn_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>

