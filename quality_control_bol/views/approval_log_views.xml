<odoo>
        <!-- Tree View -->
    <record id="view_approval_log_tree" model="ir.ui.view">
        <field name="name">aproval.log.tree</field>
            <field name="model">approval.log</field>
            <field name="arch" type="xml">
                <tree editable="bottom" string="Approval Log">
                    <field name="sequence" widget="handle"/>
                    <field name="role_id"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="date"/>
                    <field name="last_approval_role" column_invisible="1"/>
                    <field name="project_fsn_id" column_invisible="1"/>
                    <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',50]}"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_approval_log_form" model="ir.ui.view">
            <field name="name">aproval.log.form</field>
            <field name="model">approval.log</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                           <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date"/>
                            <field name="role_id"/>
                            <field name="last_approval_role" invisible="1"/>
                            <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',200]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    <!-- Configuration/Lead & Members signatures/Members signatures Menu -->
    <record id="approval_log_action" model="ir.actions.act_window">
        <field name="name">Approval Log</field>
        <field name="res_model">approval.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p>
        </field>
    </record>

</odoo>

