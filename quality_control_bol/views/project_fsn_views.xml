<odoo>

    <record id="view_project_fsn_tree" model="ir.ui.view">
        <field name="name">Project Fsn Tree</field>
        <field name="model">project.fsn</field>
        <field name="arch" type="xml">
            <tree string="FSN" decoration-info="not approved" decoration-success="approved" class="o_purchase_order" js_class="purchase_dashboard_list" sample="1">
                <field name="name"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="area"/>
                <field name="date_requested"/>
                <field name="project_id"/>
                <field name="approved" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_project_fsn_form" model="ir.ui.view">
        <field name="name">Project Fsn Form</field>
        <field name="model">project.fsn</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="approval_state_ids" invisible="1"/>
                    <field name="approval_state_id" widget="statusbar"/>
                    <field name="approved" invisible="1"/>
                    <button name="button_approve" type="object" string="Approve"/>
                    <button name="signed" type="object" string="Signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <div class="d-flex">
                                <field name="name"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="project_id" invisible="project_id == False" readonly="1"/>
                            <field name="requested_by_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" widget="many2one_avatar_user"/>
                            <field name="area"/>
                            <field name="document_url" invisible="1"/>
                            <field name="date_requested"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <div>
                                <separator name="problem_or_incident_identification" string="Problem incident identification"/>
                                <field name="problem_or_incident_identification"/>
                            </div>
                            <div>
                                <separator name="incident_description" string="Incident description"/>
                                <field name="incident_description" nolabel="1"/>
                            </div>
                            <div>
                                <separator name="request_objective" string="Request objective"/>
                                <field name="request_objective" nolabel="1"/>
                            </div>
                            <div>
                                <separator name="request_description" string="Request description"/>
                                <field name="request_description"/>
                            </div>
                            <div>
                                <separator name="controls_exceptions_assumptions" string="Controls/exceptions/assumptions"/>
                                <field name="controls_exceptions_assumptions"/>
                            </div>
                            <div>
                                <separator name="strategic_alignment" string="Strategic Alignment"/>
                                <field name="strategic_alignment"/>
                            </div>
                            <div>
                                <separator name="problem_identification" string="Problem Identification"/>
                                <field name="problem_identification"/>
                            </div>

                            <group cols="2">
                                <field name="problem_incident_recurrence"/>
                                <field name="affected_system_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="request_benefits_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                        </page>
                        <page string="FSN Sin Firma">
                            <group>
                                <field name="document_filename" invisible="1"/>
                                <field name="document" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename"/>
                            </group>
                        </page>
                        <page string="FSN Firmado">
                            <group>
                                <field name="document_signed_filename" invisible="1"/>
                                <field name="document_signed" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename" readonly="1"/>
                            </group>
                        </page>
                        <page string="Approval Log">
                            <field name="approval_log_ids" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="project_fsn_action" model="ir.actions.act_window">
        <field name="name">Project FSN</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.fsn</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Menus -->
    <menuitem
        parent="project.menu_main_pm"
        action="project_fsn_action"
        id="project_fsn_main_menu"
        name="Project FSN"
        sequence="0"/>

