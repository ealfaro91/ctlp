<odoo>

    <template id="portal_my_home_menu_document" name="Portal layout : document menu entries" inherit_id="portal.portal_breadcrumbs" priority="10">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'document' or document" t-attf-class="breadcrumb-item #{'active ' if not document else ''}">
                <a t-if="document" t-attf-href="/my/documents?{{ keep_query() }}">document to approve</a>
                <t t-else="">Document to approve</t>
            </li>
            <li t-if="document" class="breadcrumb-item active">
                <t t-out="document.name" t-if="document.name != '/'"/>
                <t t-else=""><em>Draft Document</em></t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_document" name="Show document to approve" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">document</t>
                <t t-set="url" t-value="'/my/document'"/>
                <t t-set="text">Sing, follow and download your document.</t>
                <t t-set="placeholder_count" t-value="'document_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_document" name="My document approval">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Documentos publicados</t>
            </t>
<!--            <t t-if="not grouped_document">-->
<!--                <div class="alert alert-warning mt8" role="alert">-->
<!--                    <p>No tickets found.</p>-->
<!--                </div>-->
<!--            </t>-->
            <div t-if="not documents" class="alert alert-warning" role="alert">
                No hay documentos publicados para su visualización.
                Contacte al administrador en caso de que necesite acceso a algun documento.
            </div>
            <div t-if="documents">
                <h1>Documentos publicados</h1>
            </div>
            <t t-if="documents" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Nombre</th>
                        <th>Area</th>
                        <th>Tipo de documento</th>
                        <th>Version</th>
                    </tr>
                </thead>

                <t t-foreach="documents" t-as="document">
                    <tr>
                        <td>
                            <a t-attf-href="/web/content/#{document._name}/#{document.id}/document_signed" target="_blank">
                                <t t-esc="document.name"/>
                            </a>
<!--                            <a t-attf-href="/my/documents/#{document.id}?{{ keep_query() }}"><t t-esc="document.name"/></a>-->
                        </td>
                        <td>
                            <span t-field="document.area_id.name"/>
                        </td>
                        <td>
                            <span t-field="document.document_file_type_id.name"/>
                        </td>
                        <td>
                            <span t-field="document.version_id.version"/>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="my_document" name="My Digital document Sign" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (document._name, document.id, action.id)"/>
                </t>
            </t>
            <div class="row mt16 o_portal_doc_sidebar">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>

                    <t t-set="title">
                        <h2 class="mb-0"><b t-field="document.name"/> </h2>
                    </t>
                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item d-grid align-content-start">

                                <a role="button" class="btn btn-primary d-block" data-bs-toggle="modal" data-bs-target="#modalaccept" href="#">
                                    <i class="fa fa-check"/> Accept &amp; Sign
                                </a>

                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 me-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn" t-attf-href="/my/document/#{document.id}?report_type=pdf&amp;download=True" title="Download"><i class="fa fa-download"/> Download</a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-attf-href="/my/document/#{document.id}?report_type=pdf" id="print_invoice_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>
                                    </div>
                                </div>
                            </li>

                            <li class="navspy list-group-item ps-0 flex-grow-1" t-ignore="true" role="complementary">
                                <ul class="nav flex-column bs-sidenav"></ul>
                            </li>

                            <li class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">Aprobador</strong>
                                </div>
                                <div class="row flex-nowrap">
                                    <div class="col flex-grow-0 pe-2">
                                      <img class="rounded-circle mr4 float-start o_portal_contact_img"
                                             t-att-src="image_data_uri(approval_log.user_id.avatar_128)"
                                             alt="Contact"/>
                                    </div>
                                    <div class="col ps-0" style="min-width: 150px">
                                        <span t-esc="approval_log.user_id"
                                            t-options='{"widget": "contact", "fields": ["name", "phone", "email"], "no_marker": True}'/>
                                        <a href="#discussion" class="small">
                                            <i class="fa fa-comment"></i> Send message
                                        </a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </t>
                </t>

                <!-- Page content -->
                <div id="document_page_content" class="col-12 col-lg-9 col-xl-8 mt-5 mt-lg-0">
                    <!-- modal relative to the actions sign -->
                    <div role="dialog" class="modal fade" id="modalaccept">
                        <div class="modal-dialog" t-if="document">
                            <form id="accept" method="POST" t-att-data-order-id="document.id" class="js_accept_json modal-content js_website_submit_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <header class="modal-header">
                                    <h4 class="modal-title">Approve Needs Request Form </h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </header>
                                <main class="modal-body" id="sign-dialog">
                                    <p>
                                        <span>By signing this document, I agree to the content :</span>
                                        <ul>
                                            <li><span>Accepted on the behalf of:</span> <b t-field="approval_log.user_id.name"/></li>
                                        </ul>
                                    </p>
                                    <t t-call="portal.signature_form">
                                        <t t-set="call_url" t-value="document.get_portal_sign_url()"/>
                                        <t t-set="default_name" t-value="approval_log.user_id.name"/>
                                    </t>
                                </main>
                            </form>
                        </div>
                    </div>

                    <!-- status messages -->
                    <div t-if="message == 'sign_ok'" class="alert alert-success alert-dismissable d-print-none" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                        <strong>Thank You!</strong>
                        Your document log has been signed.
                    </div>
<!--                    <div t-if="document.state == 'delegated'" class="alert alert-success alert-dismissible d-print-none" role="alert">-->
<!--                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>-->
<!--                        <strong>This document is authorized and valid.</strong>-->
<!--                    </div>-->
<!--                    <div t-if="document.state == 'cancelled'" class="alert alert-danger alert-dismissible d-print-none" role="alert">-->
<!--                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>-->
<!--                        <strong>This document has been canceled.</strong> <a role="button" href="#discussion"><i class="fa fa-comment"/> Contact us to get a new document.</a>-->
<!--                    </div>-->
<!--                    <div t-if="document.state == 'ended'" class="alert alert-danger alert-dismissible d-print-none" role="alert">-->
<!--                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>-->
<!--                        <strong>This document has been ended.</strong> <a role="button" href="#discussion"><i class="fa fa-comment"/> Contact us to get a new document.</a>-->
<!--                    </div>-->


                    <!-- main content -->
                    <div t-attf-class="#{'pb-5' if report_type == 'html' else ''}" id="document_content">
                        <div t-call="quality_control_bol.my_document_content"/>
                    </div>

                    <!-- bottom actions -->
                    <div class="d-flex justify-content-center gap-1 d-print-none">
                        <div class="col-sm-auto mt8">
                            <a  role="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalaccept" href="#">
                                <i class="fa fa-check"/> Accept &amp; Sign
                            </a>
                        </div>
                        <div class="col-sm-auto mt8">
                            <a role="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalreview"><i class="fa fa-comment"/> Solicitar revisión</a>
<!--                            <div class="modal-dialog" role="document">-->
<!--                                <div class="modal-content">-->
<!--                                <div class="modal-header bg-danger">-->
<!--                                    <h5 class="modal-title">Ingrese el comentario de revisión</h5>-->
<!--                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>-->
<!--                                </div>-->
<!--                                    <form action="/request/review/#{document.id}" method="post" class="modal-body" id="modalreview">-->
<!--                                    <div>-->
<!--                                        <input name="message" type="text" required="1"-->
<!--                                            placeholder="Revisión"/>-->
<!--                                        <hr/>-->
<!--                                    </div>-->
<!--                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>-->
<!--                                    </form>-->
<!--                                    <div class="modal-footer justify-content-start">-->
<!--                                        <button type="submit" class="btn btn-danger"/>-->
<!--                                        <button type="button" class="btn" data-bs-dismiss="modal">-->
<!--                                            Cancel-->
<!--                                        </button>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </div>-->
                        </div>
                        <div class="d-flex justify-content-center gap-1 d-print-none">
                            <div class="col-sm-auto mt8">
                                <a role="button" class="btn btn-secondary" href="#discussion"><i class="fa fa-comment"/> Feedback</a>
                            </div>
                        </div>
                    </div>


                    <!-- chatter -->
                    <hr/>
                    <div id="document_communication">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="document"/>
                        </t>
                    </div>

                </div>
            </div>
        </xpath>
    </template>

    <template id="my_document_content" name="document Content">
        <div id="document_report_content" class="col-12 col-lg mt32">
            <div class="o_portal_html_view shadow p-3" style="background-color: white;">
                <t t-if="document.document_signed">
                    <iframe
                        t-att-src="'/pdf_inline/ir.attachment/%s/document_signed' % document.id"
                        width="100%"
                        height="800px"
                        frameborder="0"
                        type="application/pdf"/>
                </t>
                <t t-else="">
                    <p>No PDF attached to this document log.</p>
                </t>
            </div>
        </div>
    </template>

</odoo>
