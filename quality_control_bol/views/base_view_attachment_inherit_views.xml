    <record id="ir_attachment_view_kanban_inh" model="ir.ui.view">
        <field name="name">ir.attachment.view.kanban.inh</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="mail.view_document_file_kanban"/>
           <field name="arch" type="xml">
               <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">privacy_type</attribute>
            </xpath>
           </field>
    </record>

    <record id="ir_attachment_view_form_inh" model="ir.ui.view">
        <field name="name">ir.attachment.view.form.inh</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="state" widget="statusbar"/>
            </xpath>
            <xpath expr="//label[@for='name']" position="before">
<!--                <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"/>-->
                <widget name="web_ribbon" title="Publicado" bg_color="text-bg-info" invisible="state != 'published'"/>
            </xpath>
            <xpath expr="//field[@name='mimetype']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[5]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='datas']" position="after">
                <field name="privacy_type"/>
                <field name="version_id"/>
                <field name="area_id"/>
                <field name="document_file_type_id"/>
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Approval log">
                        <label for="author_user_ids" string="Authors"/>
                        <field name="author_user_ids" readonly="sent_approval_request"  context="{'default_approval_type': 'author'}">
                        <label for="reviewer_user_ids" string="Reviewers"/>
                        <field name="reviewer_user_ids" nolabel="1" readonly="sent_approval_request"  context="{'default_approval_type': 'reviewer'}">
                        <label for="approval_user_ids" string="Approvers"/>
                        <field name="approval_user_ids" nolabel="1" readonly="sent_approval_request"  context="{'default_approval_type': 'approver'}">
                    </page>
<!--                        <field name="author_ids" nolabel="1" context="{'default_attachment_id': active_id, 'default_approval_type': 'author'}">-->
<!--                            <tree editable="bottom" string="Approval Log">-->
<!--                                <field name="sequence" widget="handle"/>-->
<!--                                <field name="user_id" widget="many2one_avatar_user"/>-->
<!--                                <field name="request_sign_date"/>-->
<!--                                <field name="signed_date"/>-->
<!--                                <field name="attachment_id" column_invisible="1"/>-->
<!--                                <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',50]}"/>-->
<!--                            </tree>-->
<!--                        </field>-->
<!--                    </page>-->
<!--                    <page string="Reviewers">-->
<!--                        <field name="reviewer_ids" nolabel="1" context="{'default_attachment_id': active_id, 'default_approval_type': 'reviewer'}">-->
<!--                            <tree editable="bottom" string="Approval Log">-->
<!--                                <field name="sequence" widget="handle"/>-->
<!--                                <field name="user_id" widget="many2one_avatar_user"/>-->
<!--                                <field name="request_sign_date"/>-->
<!--                                <field name="signed_date"/>-->
<!--                                <field name="attachment_id" column_invisible="1"/>-->
<!--                                <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',50]}"/>-->
<!--                            </tree>-->
<!--                        </field>-->
<!--                    </page>-->
<!--                    <page string="Approvers">-->
<!--                        <field name="approval_log_ids" nolabel="1"  context="{'default_attachment_id': active_id, 'default_approval_type': 'approver'}">-->
<!--                            <tree editable="bottom" string="Approval Log">-->
<!--                                <field name="sequence" widget="handle"/>-->
<!--                                <field name="user_id" widget="many2one_avatar_user"/>-->
<!--                                <field name="attachment_id" column_invisible="1"/>-->
<!--                                <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',50]}"/>-->
<!--                            </tree>-->
<!--                        </field>-->
<!--                    </page>-->
                    <page string="Versions">
                        <field name="version_ids" nolabel="1"/>
                    </page>
                    <page string="Documento Firmado">
                        <group>
                            <field name="document_signed_filename" invisible="1"/>
                            <field name="document_signed" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//form" position="inside">
                 <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="button_send_reviewer_request" type="object" class="btn-info" string="Enviar para aprobación" icon="fa-envelope"/>
                <button name="button_publish_document" type="object" class="btn-primary" string="Publicar" icon="fa-bullhorn"/>
            </xpath>
        </field>
    </record>

    <record id="document_directory_kanban_view_inh" model="ir.ui.view">
        <field name="name">document.directory.kanban.view.inh</field>
        <field name="model">document.directory</field>
        <field name="inherit_id" ref="windx_documents_management_preview.document_directory_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">area_id</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='tag_ids'" position="before">-->
<!--                  <field name="area_id" widget="badge" options="{'color_field': 'color'}"/>-->
<!--            </xpath>-->
        </field>
    </record>






</odoo>
