<odoo>

    <!-- SEARCH VIEW INHERIT -->

    <record id="ir_attachment_view_search_inh" model="ir.ui.view">
        <field name="name">ir.attachment.view.search.inh</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="windx_documents_management_preview.view_attachment_search_inherit_document_management"/>
        <field name="arch" type="xml">
             <xpath expr="//filter[@name='my_document']" position="after">
                 <filter name="document_type" string="Tipo de documento" context="{'group_by':'document_file_type_id'}"/>
             </xpath>
         </field>
    </record>


    <!-- KANBAN VIEW INHERIT -->

    <record id="ir_attachment_view_kanban_inh" model="ir.ui.view">
        <field name="name">ir.attachment.view.kanban.inh</field>
        <field name="model">ir.attachment</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="mail.view_document_file_kanban"/>
           <field name="arch" type="xml">
               <xpath expr="//kanban" position="attributes">
                   <attribute name="default_group_by">document_file_type_id</attribute>
                   <attribute name="default_create">False</attribute>
               </xpath>
               <xpath expr="//field[@name='name']" position="after">
                   <field name="state"/>
                   <field name="document_file_type_id"/>
               </xpath>
                <xpath expr="//div[hasclass('o_kanban_image')]" position="before">
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-info" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-info" invisible="state != 'published'"/>
               </xpath>
           </field>
    </record>

    <!-- LIST VIEW INHERIT -->

    <record id="ir_attachment_view_list_quality" model="ir.ui.view">
        <field name="name">ir.attachment.view.list.quality</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="document_directory_id"/>
                <field name="document_file_type_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW INHERIT -->

    <record id="ir_attachment_view_form_inh" model="ir.ui.view">
        <field name="name">ir.attachment.view.form.inh</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="windx_documents_management_preview.view_attachment_form_inherit_document_management"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="button_author_sign" type="object" class="btn-primary"
                        invisible="signed_by_author"
                        string="Author signature" icon="fa-pencil"/>
                <button name="%(quality_control_bol.replace_document_version_action)d"
                        context="{'default_attachment_id': id, 'default_old_document_version_id': version_id}"
                        type="action" class="btn-danger" string="Reemplazar versión" icon="fa-file"
                        invisible="state != 'to_review'"
                />
                <button name="button_publish_document" type="object" class="btn-primary" string="Publish" icon="fa-bullhorn"
                        invisible="privacy_type != 'public' or state == 'published'"/>
                <button name="button_send_approval_request" type="object"
                        class="btn-info" string="Send approval request"
                        icon="fa-envelope" invisible="sent_approval_request"/>
                <field name="state" widget="statusbar"/>
                <field name="signed_by_author" invisible="1"/>
                <field name="sent_approval_request" invisible="1"/>
                <field name="published" invisible="1"/>
            </xpath>
            <xpath expr="//label[@for='name']" position="before">
                <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                <widget name="web_ribbon" title="Publicado" bg_color="text-bg-info" invisible="state != 'published'"/>
            </xpath>
            <xpath expr="//label[@for='datas']" position="replace">
                <label for="datas" class="mt-1" string="Archivo"/>
            </xpath>
            <xpath expr="//field[@name='mimetype']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='datas']" position="attributes">
                 <attribute name="readonly">state != 'to_review'</attribute>
                 <attribute name="accept">.pdf</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">state != 'to_review'</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='directory_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='document_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='document_directory_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[4]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[5]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='datas']" position="after">
                <separator/>
                <group string="General Information">
                    <field name="create_uid" readonly="1"/>
                    <field name="document_directory_id"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                           readonly="state != 'to_review'"/>
                    <field name="area_id"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                           readonly="state != 'to_review'"/>
                    <field name="privacy_type" required="1" readonly="state != 'to_review'"/>
                    <field name="document_file_type_id"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" required="1"
                           readonly="state != 'to_review'"/>
                    <field name="has_subcategories" invisible="1"/>
                    <field name="child_type_id" invisible="not has_subcategories"
                           readonly="state != 'to_review'"/>
                    <field name="version_id" required="1" context="{'default_attachment_id': id}"
                           readonly="state != 'to_review'"/>
                </group>
                <group>
                        <field name="document_file_type_ids" invisible="1"/>
                        <field name="allowed_user_ids" invisible="1"/>
                        <field name="user_ids"
                               string="Users with access"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                               readonly="state != 'to_review'"/>
                        <field name="directory_tag_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                               readonly="state != 'to_review'"/>
                        <field name="document_tag_ids"
                               widget="many2many_tags"
                               readonly="state != 'to_review'"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    </group>

            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Approval log">
                        <label for="approval_log_ids" string="Reviewers and Approvers"/>
                        <field name="approval_log_ids" nolabel="1" readonly="sent_approval_request"
                               context="{'default_document_id': id, 'tree_view_ref': 'quality_control.view_approval_log_document_tree'}"/>
                    </page>
                    <page string="Versions">
                        <field name="version_ids"
                               readonly="state != 'to_review'"
                               nolabel="1"/>
                    </page>
                    <page string="Signed document">
                        <group>
                            <field name="document_signed_filename" invisible="1"/>
                            <field name="document_signed" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename" readonly="1"/>
                        </group>
                    </page>
                    <page string="Review requests">
                        <field name="attachment_review_request_ids" nolabel="1" readonly="1">
                            <tree editable="bottom">
                                <field name="attachment_id" column_invisible="1"/>
                                <field name="user_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" widget="many2one_avatar_user"/>
                                <field name="date"/>
                                <field name="version_id"/>
                                <field name="message"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//form" position="inside">
                 <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="windx_documents_management_preview.act_all_attachment_from_document_directory" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
               (0, 0, {'view_mode': 'kanban', 'view_id': ref('quality_control_bol.ir_attachment_view_kanban_inh')}),
               (0, 0, {'view_mode': 'tree', 'view_id': ref('quality_control_bol.ir_attachment_view_list_quality')}),
               (0, 0, {'view_mode': 'form', 'view_id': ref('windx_documents_management_preview.view_attachment_form_inherit_document_management')})]"/>
    </record>

</odoo>
