<odoo>

    <!-- FORM VIEW -->

   <record id="helpdesk_ticket_area_form_inh" model="ir.ui.view">
        <field name="name">helpdesk.ticket.area.form.inh</field>
        <field name="model">helpdesk.ticket.area</field>
        <field name="inherit_id" ref="helpdesk_bol.helpdesk_ticket_area_form_view"/>
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
               <field name="show_in_directory"/>
            </field>
        </field>
   </record>

    <!-- TREE VIEW -->

    <record id="helpdesk_ticket_area_tree_inh" model="ir.ui.view">
        <field name="name">helpdesk.ticket.area.tree.inh</field>
        <field name="model">helpdesk.ticket.area</field>
        <field name="inherit_id" ref="helpdesk_bol.helpdesk_ticket_area_tree_view"/>
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
               <field name="show_in_directory"/>
           </field>
        </field>
    </record>


</odoo>
