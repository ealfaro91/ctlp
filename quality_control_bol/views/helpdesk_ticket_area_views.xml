<odoo>

    <!-- FORM VIEW -->

   <record id="helpdesk_ticket_area_form_inh" model="ir.ui.view">
        <field name="name">helpdesk.ticket.area.form.inh</field>
        <field name="model">helpdesk.ticket.area</field>
        <field name="inherit_id" ref="helpdesk_bol.helpdesk_ticket_area_form_view"/>
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
               <field name="show_in_directory"/>
            </field>
        </field>
   </record>

    <!-- TREE VIEW -->

    <record id="helpdesk_ticket_area_tree_inh" model="ir.ui.view">
        <field name="name">helpdesk.ticket.area.tree.inh</field>
        <field name="model">helpdesk.ticket.area</field>
        <field name="inherit_id" ref="helpdesk_bol.helpdesk_ticket_area_tree_view"/>
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
               <field name="show_in_directory"/>
           </field>
        </field>
    </record>

    <!-- ACTION -->
    <record id="helpdesk_ticket_area_document_action" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.area</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[("show_in_directory", "=", True)]</field>
        <field name="context"></field>
    </record>

       <!-- MENU -->
    <menuitem
        parent="windx_documents_management_preview.menu_document_configuration"
        action="helpdesk_ticket_area_document_action"
        id="helpdesk_ticket_area_document_main_menu"
        name="Areas"
        sequence="0"/>


</odoo>
