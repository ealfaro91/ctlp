<odoo noupdate="0">

     <!-- Project FSN -->
    <record id="order_approval_state_pending" model="approval.state">
        <field name="sequence">0</field>
        <field name="name">Pending</field>
    </record>

    <record id="approval_requester_fsn" model="approval.state">
        <field name="sequence">1</field>
        <field name="name">Solicitante (GAS)</field>
        <field name="role_id" ref="project_bol.group_fsn_requester"/>
        <field name="model_id" ref="project_bol.model_project_fsn"/>
        <field name="last_approval_role">False</field>
    </record>

    <record id="approval_manager_area_fsn" model="approval.state">
        <field name="sequence">2</field>
        <field name="name">Gerencia del Área</field>
        <field name="role_id" ref="project_bol.group_fsn_area_manager"/>
        <field name="model_id" ref="project_bol.model_project_fsn"/>
        <field name="last_approval_role">False</field>
    </record>

    <record id="approval_manager_ti_fsn" model="approval.state">
        <field name="sequence">3</field>
        <field name="name">Gerencia TI (GTI)</field>
        <field name="role_id" ref="project_bol.group_fsn_ti_manager"/>
        <field name="model_id" ref="project_bol.model_project_fsn"/>
        <field name="last_approval_role">False</field>
    </record>

    <record id="approval_general_manager_fsn" model="approval.state">
        <field name="sequence">4</field>
        <field name="name">Gerencia General (GG)</field>
        <field name="role_id" ref="project_bol.group_fsn_general_manager"/>
        <field name="model_id" ref="project_bol.model_project_fsn"/>
        <field name="last_approval_role">True</field>
    </record>

    <record id="order_approval_state_approved" model="approval.state">
        <field name="sequence">5</field>
        <field name="name">Approved</field>
    </record>


</odoo>
