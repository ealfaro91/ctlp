<odoo>
    <data noupdate="0">

        <record id="document_approval_email" model="mail.template">
            <field name="name">Aprobación de Document</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="subject">{{ object.name }}</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:auto;background: #FFFFFF;color:#777777">
                    <p>Hola</p>
                    <p>Ha sido invitado a realizar la aprobación del Documento.</p>
                    <ul>
                        <li>
                            Documento: <t t-out="object.name"/>
                        </li>
                        <li>
                            Portal Access Link:  <a t-attf-href="{{ object.document_url }}"><t t-out="object.document_url"/></a>
                        </li>
                    </ul>
<!--                    <p>To complete the authorization process, please access our online delegation system to sign and accept the document.</p>-->
<!--                    <p>Note: By electronically signing the form, you confirm that you have completed the applicable training and will only conduct delegated tasks for which you have been trained.</p>-->
                    <p>This is an automatically generated email, please do not reply.</p>
                    <p>Best regards.</p><br/>
                </div>
            </field>
        </record>

    </data>
</odoo>
