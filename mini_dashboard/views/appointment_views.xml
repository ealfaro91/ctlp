<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--Adding the dashboard in list view-->
    <record id="patient_ctms_clinic_appointment_view_tree_dashboard" model="ir.ui.view">
        <field name="name">ctms.clinic.appointment.dashboard</field>
        <field name="model">ctms.clinic.appointment</field>
        <field name="inherit_id" ref="trial_clinic.ctms_clinic_appointment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">trial_appointment_dashboard_list</attribute>
            </xpath>
        </field>
    </record>

    <!--Adding additional filters used in mini dashboard-->
    <record id="ctms_clinic_appointment_view_dashboard_:search" model="ir.ui.view">
        <field name="name">ctms.clinic.appointment.view.search.dashboard</field>
        <field name="model">ctms.clinic.appointment</field>
        <field name="inherit_id"  ref="trial_clinic.ctms_clinic_appointment_view_search"/>
        <field name="arch" type="xml">
            <filter name="app_today" position="after">
                <filter string="Today's appointments - In Progress" name="app_today_in_progress"  domain="[('init_date', '=', context_today()), ('state', 'in', ('wait', 'consultation'))]"/>
                <filter string="Today's appointments - Closed or Typed" name="app_today_closed_typed"  domain="[('init_date', '=', context_today()), ('state', 'in', ('done', 'typed'))]"/>
                <filter string="Today's Appointments - Mine" name="filter_my_today_appointments"  domain="[('init_date', '=', context_today()), '|', '|', ('monitoring_user_id', '=', uid), ('medical_user_id', '=', uid), ('user_ids', 'in', [uid])]"/>
                <filter string="Today's Appointments - Mine In Progress" name="filter_my_today_appointments_in_progress"  domain="[('init_date', '=', context_today()), ('state', 'in', ('wait', 'consultation')), '|', '|', ('monitoring_user_id', '=', uid), ('medical_user_id', '=', uid), ('user_ids', 'in', [uid])]"/>
                <filter string="Today's Appointments - Mine Closed or Typed" name="filter_my_today_appointments_closed_typed"  domain="[('init_date', '=', context_today()), ('state', 'in', ('done', 'typed')),  '|', '|', ('monitoring_user_id', '=', uid), ('medical_user_id', '=', uid), ('user_ids', 'in', [uid])]"/>
            </filter>
        </field>
    </record>
</odoo>
