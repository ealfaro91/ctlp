#. module: project_bol
#: model:ir.actions.report,print_report_name:project_bol.action_fsn_report
msgid "'FSN - %s' % (object.name)"
msgstr "'FSN - %s' % (object.name)"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "1. Project Information"
msgstr "1. Información del proyecto"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "2. Problem or Incident Identification"
msgstr "2. Identificación del incidente/problema/ necesidad que genera esta solicitud"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "3. Request Objective"
msgstr "3. Objetivo de la solicitud"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "4. Request Description"
msgstr "4. Descripción especifica de la solicitud"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "5. Controls/exceptions/assumptions"
msgstr "5. Controles/excepciones/suposiciones"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "6. Strategic Alignment"
msgstr "6. Alineación estratégica"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "7. Affected System"
msgstr "7. Sistema Afectado"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "8. Project Benefits"
msgstr "8. Beneficios del proyecto"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.report_fsn_template
msgid "NEEDS REQUEST FORM"
msgstr "FORMULARIO DE SOLICITUD DE NECESIDADES"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid "<i class=\"fa fa-check\"/> Accept &amp; Sign"
msgstr "<i class=\"fa fa-check\"/> Aceptar &amp; Firmar"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid "<i class=\"fa fa-comment\"/> Feedback"
msgstr "<i class=\"fa fa-comment\"/> Retroalimentación"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid "<i class=\"fa fa-comment\"/> Send message"
msgstr "<i class=\"fa fa-comment\"/> Enviar mensaje"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid "<i class=\"fa fa-download\"/> Download"
msgstr "<i class=\"fa fa-download\"/> Descargar"

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid "<i class=\"fa fa-print\"/> Print"
