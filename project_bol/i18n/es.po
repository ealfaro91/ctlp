#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.my_fsn
msgid ""
"<strong>Thank You!</strong>\n"
"                        Your FSN has been signed."
msgstr ""
"<strong>Gracias!</strong>\n"
"                        Su FSN ha sido firmado."

