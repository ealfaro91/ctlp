#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.portal_my_fsn
msgid ""
"<span class=\"badge rounded-pill text-bg-info\">\n"
"                                    <span class=\"d-none d-md-inline\"> Draft</span>\n"
"                                </span>"
msgstr ""

#. module: project_bol
#: model_terms:ir.ui.view,arch_db:project_bol.portal_my_fsn
msgid ""
"<span class=\"badge rounded-pill text-bg-success\">\n"
"                                    <span class=\"d-none d-md-inline\"> Delegated</span>\n"
"                                </span>"
msgstr ""

