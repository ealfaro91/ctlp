    <record id="project_project_stage_2" model="project.project.stage">
        <field name="sequence">20</field>
        <field name="name">Ejecución / Desarrollo</field>
        <field name="fold" eval="True"/>
    </record>

    <record id="project_project_stage_3" model="project.project.stage">
        <field name="sequence">25</field>
        <field name="name">Pruebas de Usuario</field>
        <field name="fold" eval="True"/>
    </record>

    <record id="project_project_stage_4" model="project.project.stage">
        <field name="sequence">25</field>
        <field name="name">Puesta en Producción</field>
        <field name="fold" eval="True"/>
    </record>

</odoo>
