<odoo>

    <!-- TREE VIEW -->

    <record id="project_fsn_benefit_tree_view" model="ir.ui.view">
        <field name="name">project.fsn.benefit.tree.view</field>
        <field name="model">project.fsn.benefit</field>
        <field name="arch" type="xml">
            <tree editable="bottom" string="Project FSN Benefit">
                <field name="name"/>
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->

    <record id="project_fsn_benefit_form_view" model="ir.ui.view">
        <field name="name">project.fsn.benefit.form.view</field>
        <field name="model">project.fsn.benefit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Benefit"/>
                        <h1>
                            <div class="d-flex">
                                <field name="name"/>
                                <field name="color" widget="color_picker"/>
                                <field name="active" invisible="1"/>
                            </div>
                        </h1>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->

    <record id="project_fsn_benefit_search_view" model="ir.ui.view">
        <field name="name">project.fsn.benefit.search.view</field>
        <field name="model">project.fsn.benefit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->

    <record id="project_fsn_benefit_action" model="ir.actions.act_window">
        <field name="name">Project Fsn Benefit</field>
        <field name="res_model">project.fsn.benefit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENUS -->

   <menuitem
        id="project_fsn_benefit_menu"
        name="Project FSN Benefit"
        parent="project.menu_project_config"
        action="project_fsn_benefit_action"
        sequence="16"/>


</odoo>
