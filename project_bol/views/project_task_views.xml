<odoo>

    <record id="view_project_task_form_inh" model="ir.ui.view">
        <field name="name">project.task.form.inh</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='milestone_id']" position="after">
                <field name="project_stage_id" required="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                 <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']" position="attributes">
                 <attribute name="invisible">1</attribute>
            </xpath>


        </field>
    </record>
<!--project.view_task_tree2-->

</odoo>
