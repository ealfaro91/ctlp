<odoo>

     <!-- TREE VIEW -->
    <record id="view_project_fsn_tree" model="ir.ui.view">
        <field name="name">Project FSN Tree</field>
        <field name="model">project.fsn</field>
        <field name="arch" type="xml">
            <tree string="FSN" decoration-info="state == 'to_approve'"
                  decoration-warning="state == 'approval_request'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'cancelled'"
                  js_class="project_fsn_dashboard_list" sample="1">
                <field name="name"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="area"/>
                <field name="date_requested"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-warning="state == 'approval_request'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="project_id" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->

    <record id="view_project_fsn_form" model="ir.ui.view">
        <field name="name">Project FSN Form</field>
        <field name="model">project.fsn</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="sent_approval_request" invisible="1"/>
                    <button name="button_send_approval_request" type="object" class="btn-primary"
                            invisible="sent_approval_request or not signed_by_author or state != 'to_approve'" string="Send approval request" icon="fa-envelope"/>
                    <button name="button_cancel" type="object" class="btn-secondary"
                            invisible="state == 'cancelled'" string="Cancel" icon="fa-ban"/>
                    <button name="button_author_sign" type="object" class="btn-primary"
                            invisible="signed_by_author or not document" string="Author signature" icon="fa-pencil"/>
                    <button name="button_generate_fsn" type="object" class="btn-primary"
                            invisible="sent_approval_request or signed_by_author or not id" string="Generate FSN" icon="fa-file" confirm="The FSN PDF will be generated again."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div name="button_box" id="button_box" class="oe_button_box">
                        <button name="action_view_project" class="oe_stat_button" type="object" icon="fa-list">
                            <field string="Project" name="project_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Approval pending" bg_color="text-bg-danger" invisible="state == 'approved'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-muted" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <div class="d-flex">
                                <field name="name" readonly="state != 'to_approve'"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="requested_by_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" widget="many2one_avatar_user" readonly="state != 'to_approve'"/>
                            <field name="area"/>
                            <field name="document_url" invisible="1"/>
                            <field name="date_requested"  readonly="state != 'to_approve'"/>
                            <field name="signed_by_author" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <label for="problem_or_incident_identification" string="Problem incident identification"/>
                                    <field name="problem_or_incident_identification" nolabel="1" readonly="state != 'to_approve'"/>
                                </group>
                                <group>
                                    <label for="request_objective" string="Request objective"/>
                                    <field name="request_objective" nolabel="1" readonly="state != 'to_approve'"/>
                                </group>
                                <group>
                                    <label for="request_description" string="Request description"/>
                                    <field name="request_description" nolabel="1" readonly="state != 'to_approve'"/>
                                </group>
                                <group>
                                    <label for="controls_exceptions_assumptions" string="Controls/exceptions/assumptions"/>
                                    <field name="controls_exceptions_assumptions" nolabel="1" readonly="state != 'to_approve'"/>
                                </group>
                                <group>
                                    <label for="strategic_alignment" string="Strategic Alignment"/>
                                    <field name="strategic_alignment" nolabel="1" readonly="state != 'to_approve'"/>
                                </group>
                                <group>
                                     <field name="problem_incident_recurrence" readonly="state != 'to_approve'"/>
                                </group>
                            </group>
                            <separator/>
                            <group>
                                <group>
                                    <field name="affected_system_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" readonly="state != 'to_approve'"/>
                                    <field name="request_benefits_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" readonly="state != 'to_approve'"/>
                                 </group>
                            </group>
                        </page>
                        <page string="Approval Log">
                            <div class="alert alert-info" colspan="4" role="alert" invisible="state != 'to_approve'">
                                Add the document approvers.
                            </div>
                            <field name="approval_log_ids" nolabel="1" context="{'default_project_fsn_id': id}" readonly="state != 'to_approve'"/>
                        </page>
                        <page string="FSN Sin Firma">
                             <div class="alert alert-info" colspan="4" role="alert" invisible="document">
                                This is the file to be signed.
                             </div>
                            <group>
                                <field name="document_filename" invisible="1"/>
                                <field name="document" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename" readonly="1"/>
                            </group>
                        </page>
                        <page string="FSN Firmado">
                            <group>
                                <field name="document_signed_filename" invisible="1"/>
                                <field name="document_signed" colspan="2" widget="pdf_viewer" nolabel="1" filename="document_filename" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients', 'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->

    <record id="view_project_fsn_search" model="ir.ui.view">
        <field name="name">Project FSN Search</field>
        <field name="model">project.fsn</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="area"/>
                <field name="date_requested"/>
                <field name="project_id"/>
                <field name="state"/>
                <field name="active"/>
                <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                <filter string="Requester" name="groupby_requester" context="{'group_by': 'requested_by_id'}"/>
            </search>
        </field>
    </record>


    <record id="project_fsn_action" model="ir.actions.act_window">
        <field name="name">Project FSN</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.fsn</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- MENUS -->
    <menuitem
        parent="project.menu_main_pm"
        action="project_fsn_action"
        id="project_fsn_main_menu"
        name="Project FSN"
        sequence="0"/>

</odoo>
