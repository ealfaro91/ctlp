<odoo>

    <record id="view_project_form_inh" model="ir.ui.view">
        <field name="name">Project Form inh</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Project Information" name="project_information">
                    <group string="FSN Information" name="fsn_information">
                        <group>
                            <field name="fsn_id" invisible="not fsn_id" readonly="1"/>
                            <field name="product_owner_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="executer_area_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="requested_area" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="requested_by_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Amount Information" name="amount_information">
                            <field name="amount_assigned" widget="monetary"/>
                            <field name="amount_used" widget="monetary"/>
                        </group>
                        <group string="Advance Information" name="advance_information">
                            <field name="closed_date" invisible="not closed_date"/>
                            <field name="delay_days"/>
                            <field name="project_status"/>
                            <field name="deviation" widget="progressbar"/>
                            <field name="total_advance" widget="progressbar"/>
                        </group>
                    </group>
                </page>
                <page string="Etapas del proyecto">
                    <field name="stage_ids" readonly="1">
                        <tree editable="bottom" string="Avance de etapas">
                            <field name="project_id" column_invisible="1"/>
                            <field name="stage_id"/>
                            <field name="advance" widget="progressbar"/>
                        </tree>
                    </field>
                </page>
            </xpath>
             <xpath expr="//field[@name='partner_id']" position="attributes">
                 <attribute name="invisible">1</attribute>
             </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                 <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                 <attribute name="required">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="project_view_tree_progress_inherit" model="ir.ui.view">
        <field name="name">project.view.tree.progress.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="total_advance" widget="progressbar"/>
            </xpath>
        </field>
    </record>

    <record id="project_view_kanban_progress_inherit" model="ir.ui.view">
        <field name="name">project.view.kanban.progress.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_primary')]/field[@name='tag_ids']" position="after">
                <span title="Total Advance"/><field name="total_advance" widget="progressbar"/>
                <span title="Status"/><field name="project_status" widget="badge" decoration-danger="project_status == 'delayed'" decoration-warning="project_status == 'alert'" decoration-success="project_status == 'on_time'" decoration-info="project_status == 'on_pause'"/>
<!--                <span title="Deviation"/><field name="deviation" widget="progressbar"/>-->
            </xpath>
<!--            <xpath expr="//div[hasclass('o_primary')]/field[@name='tag_ids']" position="after">-->
<!--    on_create="quick_create"&lt;!&ndash;                <span title="Deviation"/><field name="deviation" widget="progressbar"/>&ndash;&gt;-->
<!--            </xpath>-->
        </field>
    </record>

    <record id="project_project_views_pivot" model="ir.ui.view">
        <field name="name">project.project.view.pivot</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Analysis" disable_linking="True">
                <field name="stage_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="date_start" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_project_project_graph" model="ir.ui.view">
        <field name="name">project.project.graph</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <graph string="Projects">
                <field name="stage_id" type="row"/>
                <field name="deviation" type="row"/>
                <field name="project_status" type="row"/>
            </graph>
        </field>
    </record>

    <record id="project.open_view_project_all_group_stage" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,calendar,activity,graph,pivot</field>
    </record>

    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="name">FSN</field>
    </record>

</odoo>
