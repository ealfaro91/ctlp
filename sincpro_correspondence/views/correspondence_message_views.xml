<odoo>


    <!--  VIEWS  -->

    <record model="ir.ui.view" id="correspondence_search_view">
        <field name="name">correspondence.message.search.view</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <search>
                <separator />
                <filter name="not_assigned" string="Enviado" domain="[('state', '=', 'sent')]"/>
                <filter name="assigned" string="Asignadas" domain="[('state', '=', 'assigned')]"/>
                <separator />
                <group expand="0" string="Agrupar por">
                    <filter string="Correspondencia" name="group_reason_id" context="{'group_by': 'reason_id'}"/>
                    <filter string="Estado" name="group_state_id" context="{'group_by': 'state'}"/>
                    <filter string="Accion" name="group_action_id" context="{'group_by': 'activity_id'}"/>
                    <filter string="Tipo de correspodencia" name="group_type_id" context="{'group_by': 'document_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_tree_view">
        <field name="name">correspondence.message.tree.view</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <tree string="Mensaje" create="0">
                <field name="reason_id" optional="show"/>
                <field name="name"/>
                <field name="sent_date" string="Fecha"/>
                <field name="received_date" optional="hide" string="Fecha de recepcion"/>
                <field name="from_user_id" widget="many2one_avatar_user"/>
                <field name="to_user_id" widget="many2one_avatar_user"/>
                <field name="document_ids" widget="badge"/>
                <field name="activity_id" widget="badge"/>
                <field name="state" widget="badge" decoration-warning="state == 'sent'" decoration-info="state == 'assigned'" decoration-success="state in ['done', 'closed']" decoration-danger="state in ['todo']"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_form_view">
        <field name="name">correspondence.message.form.view</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <form string="Correspondencia">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="action_open_mail_composer">
                        <i class="fa fa-external-link"/>
                        Enviar mail
                    </button>
                    <button type="object" name="action_assign_correspondence" class="btn-primary" data-hotkey="q" invisible="state not in ['todo', 'assigned', 'done']">
                        <i class="fa fa-external-link"/>
                        Asignar
                    </button>
                    <button string="Recepcionar" type="object" name="action_receive_correspondence"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <button string="Cerrar/Archivar" type="object" name="action_close_correspondence"
                            icon="fa-box-archive" class="btn-warning" invisible="state != 'assigned'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex w-100 justify-content-between">
                            <div>
                                <h1>
                                    <field name="name" readonly="1"/>
                                </h1>
                                <p>
                                    <field name="ref" readonly="1"/>
                                    <field name="reason_state" invisible="1"/>
                                </p>
                            </div>
                        </div>
                    </div>
                    <group string="Asignar">
                        <group>
                            <field name="from_user_id" widget="many2one_avatar_user"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state != 'todo' or reason_state != 'draft'"/>
                            <field name="area_from"/>
                        </group>
                        <group>
                            <field name="to_user_id" widget="many2one_avatar_user"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state != 'todo' or reason_state != 'draft'"/>
                            <field name="area_to"/>
                        </group>
                    </group>
                    <group string="Acciones">
                        <field name="action_id" readonly="state != 'todo' or reason_state != 'draft'"/>
                    </group>
                    <group string="Motivo finalización/archivado" invisible="not reason">
                        <field name="reason"/>
                    </group>
                    <notebook>
                        <page string="Correspondencia">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Adjuntos adicionales">
                            <field name="document_ids" widget="many2many_binary" readonly="state != 'todo' or reason_state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids" string="Seguimiento"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_kanban_view">
        <field name="name">correspondence.message.kanban</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <gantt date_start="sent_date" date_stop="received_date" default_group_by="to_user_id"
                   string="Mensajes" disable_drag_drop="1" color="color">
                <field name="ref"/>
                <field name="state"/>
            </gantt>
        </field>
    </record>

    <record id="correspondence_message_calendar_view" model="ir.ui.view">
        <field name="name">correspondence_message_calendar_view</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <calendar date_start="sent_date" mode="month" color="color" date_stop="received_date" create="0">
                <field name="ref"/>
            </calendar>
        </field>
    </record>

    <!-- PIVOT VIEW  -->

    <record id="correspondence_message_view_pivot" model="ir.ui.view">
        <field name="name">correspondence.message.view.pivot</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Analysis" disable_linking="True">
                <field name="state" type="row"/>
                <field name="from_user_id" type="row"/>
                <field name="to_user_id" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW  -->

    <record id="correspondence_message_graph_view" model="ir.ui.view">
        <field name="name">correspondence.message.graph</field>
        <field name="model">correspondence.message</field>
        <field name="arch" type="xml">
            <graph string="Projects">
                <field name="state" type="row"/>
                <field name="from_user_id" type="row"/>
                <field name="to_user_id" type="row"/>
            </graph>
        </field>
    </record>


    <!--  ACTIONS  -->

    <record model="ir.actions.act_window" id="action_render_correspondence_messages">
        <field name="name">Correspondencia</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_messages_NO_ASSIGNED_by_user">
        <field name="name">Mi correspondencia no recepcionadas</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
        <field name="domain">[('state', '=', 'sent'), ('to_user_id', '=', uid)]</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_messages_ASSIGNED_by_user">
        <field name="name">Correspondencia no asignada</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
       <field name="domain">[('state', '=', 'assigned'), ('to_user_id', '=', uid)]</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_messages_all_incoming_by_user">
        <field name="name">Mis correspondencia recepcionadas</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
        <field name="context">{'search_default_group_state_id': 1}</field>
        <field name="domain">[('to_user_id', '=', uid)]</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_messages_all_by_user">
        <field name="name">Mis correspondencia recepcionadas</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
        <field name="context">{'search_default_group_state_id': 1}</field>
        <field name="domain">['|', ('to_user_id', '=', uid), ('from_user_id', '=', uid)]</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_messages_all_SENT_by_user">
        <field name="name">Mi correspondencia redireeccionada</field>
        <field name="res_model">correspondence.message</field>
        <field name="view_mode">tree,form,gantt,calendar,graph,pivot</field>
        <field name="domain">[('from_user_id', '=', uid)]</field>
    </record>





</odoo>
