<odoo>

    <record model="ir.ui.view" id="correspondence_action_tree_view">
        <field name="name">correspondence.action.tree.view</field>
        <field name="model">correspondence.action</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="priority" widget="handle"/>
                <field name="action"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_action_form_view">
        <field name="name">correspondence.action.form.view</field>
        <field name="model">correspondence.action</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="priority" widget="handle"/>
                    <field name="action"/>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_render_correspondence_action">
        <field name="name">Tipo de actividad</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
