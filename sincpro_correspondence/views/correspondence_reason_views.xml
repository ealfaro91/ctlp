<odoo>

    <record model="ir.ui.view" id="correspondence_reason_tree_view">
        <field name="name">correspondence.reason.tree.view</field>
        <field name="model">correspondence.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="issue"/>
                <field name="date"/>
                <field name="reception_date"/>
                <field name="origin"/>
                <field name="correspondence_message_ids" widget="badge" decoration-info="1"/>
                <field name="document_ids" widget="badge" decoration-warning="1"/>
                <field name="type" widget="badge" decoration-success="type == 'internal'"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_reason_form_view">
        <field name="name">correspondence.reason.form.view</field>
        <field name="model">correspondence.reason</field>
        <field name="arch" type="xml">
            <form string="Asunto">
                <field name="count_correspondence" invisible="1"/>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="action_assign_correspondence" class="btn-primary" data-hotkey="q" invisible="state != 'draft'">
                        <i class="fa fa-external-link"/>
                        Asignar
                    </button>
                    <button type="object" name="action_close" class="btn-primary" invisible="state != 'draft'">
                        <i class="fas fa-xmark"/>
                        Cerrar
                    </button>
                    <button type="object" name="action_draft" class="btn-primary" invisible="state != 'done'">
                        <i class="fa fa-folder-open"/>
                        Abrir
                    </button>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_redirect_correspondence" icon="fa-envelope">
                            <field name="count_correspondence" widget="statinfo" string="Correspondencia"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Interno" invisible="type != 'internal'"/>
                    <widget name="web_ribbon" title="Externo" invisible="type != 'external'" bgcolor="text-bg-primary"/>
                    <div class="oe_title">
                        <label for="issue" class="form-label">Nª</label>
                        <h1>
                            <field name="issue" readonly="state in ['done', 'cancel']"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="area" readonly="1"/>
                            <field name="origin" readonly="state in ['done', 'cancel']"/>
                            <field name="signer" readonly="state in ['done', 'cancel']" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="type" readonly="state in ['done', 'cancel']"/>
                            <field name="date" readonly="state in ['done', 'cancel']"/>
                            <field name="reception_date" readonly="state in ['done', 'cancel']"/>
                            <field name="document_type_id" readonly="state in ['done', 'cancel']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Correspondencia adjunta">
                            <field name="document_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </page>
                        <page string="Adjuntos adicionales">
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </page>
                        <page string="Mensajes de seguimiento">
                            <field name="correspondence_message_ids" readonly="1">
                                <tree>
                                    <field name="sent_date" string="Fecha"/>
                                    <field name="name" optional="hide"/>
                                    <field name="ref"/>
                                    <field name="document_ids" widget="many2many_tags"/>
                                    <field name="from_user_id" widget="many2one_avatar_user"/>
                                    <field name="to_user_id" widget="many2one_avatar_user"/>
                                    <field name="activity_id"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'sent'" decoration-info="state == 'assigned'" decoration-success="state in ['done', 'closed']" decoration-danger="state in ['todo']"/>
                                    <button type="object" name="action_show_correspondence" class="btn-primary" string="Ver"/>
                                </tree>
                            </field>
                        </page>
<!--                        <page string="Correspodencia Genrados/Asociados">-->
<!--                            <field name="document_ids" readonly="1">-->
<!--                                <tree open_form_view="0">-->
<!--                                    <field name="date"/>-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="elaborated_by_partner_id" widget="many2one_avatar_user"/>-->
<!--                                    <field name="to_partner_id" widget="many2one_avatar_user"/>-->
<!--                                    <field name="document_type_id"/>-->
<!--                                    <field name="state" decoration-success="state == 'assigned'" widget="badge"/>-->
<!--                                    <field name="correspondence_message_id"/>-->
<!--                                    <button type="object" name="action_show_correspondence_document" class="btn-primary" string="Ver"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_render_correspondence_reason">
        <field name="name">Correspondencia</field>
        <field name="res_model">correspondence.reason</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_render_correspondence_reason_by_user">
        <field name="name">Correspondencia</field>
        <field name="res_model">correspondence.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
    </record>

</odoo>
