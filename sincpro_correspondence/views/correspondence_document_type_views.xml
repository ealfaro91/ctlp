<odoo>

    <record model="ir.ui.view" id="correspondence_document_type_tree_view">
        <field name="name">correspondence.document.type.tree.view</field>
        <field name="model">correspondence.document.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="correspondence_document_type_form_view">
        <field name="name">correspondence.document.type.form.view</field>
        <field name="model">correspondence.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_render_correspondence_document_type">
        <field name="name">Tipo de documento</field>
        <field name="res_model">correspondence.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
